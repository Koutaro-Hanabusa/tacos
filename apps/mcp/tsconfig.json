{
  "extends": "@tacos/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../shared/*"]
    },
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../shared/restaurant-ui/**/*.ts",
    "../../shared/restaurant-ui/**/*.tsx"
  ]
}
