{
  "name": "tacos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "dev:native": "vp run --filter native dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter server dev",
    "dev:mcp": "vp run --filter @tacos/infra dev",
    "db:push": "vp run --filter @tacos/db db:push",
    "db:generate": "vp run --filter @tacos/db db:generate",
    "ci:bootstrap": "vp run --filter @tacos/infra ci:bootstrap",
    "deploy": "vp run --filter @tacos/infra deploy",
    "destroy": "vp run --filter @tacos/infra destroy",
    "check": "vp lint && vp fmt --write",
    "lint": "vp lint && vp fmt --check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tacos/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tacos/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.2.7",
    "maplibre-gl": "^5.23.0",
    "react": "19.2.3",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.33.0"
}
